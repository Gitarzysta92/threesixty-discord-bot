DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
LOG_LEVEL=info

# Persist this directory across deployments; run one bot instance.
DATA_DIR=./data
# Existing text/announcement channel in your configured server. Empty disables posts.
RESETS_CHANNEL_ID=
RESETS_POLL_SECONDS=300
ACTIVITY_COLLECTOR_ENABLED=true
ACTIVITY_ANALYSIS_ENABLED=true
ACTIVITY_RETENTION_DAYS=90
# Comma-separated channel IDs; excluded thread parents are also respected.
ACTIVITY_EXCLUDED_CHANNEL_IDS=
# Weekly activity summary: Sunday 12:00 Europe/Warsaw (automatic DST adjustment).
# Empty disables scheduled posts; /activity remains available.
ACTIVITY_SUMMARY_CHANNEL_ID=
