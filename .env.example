DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# OpenClaw companion service only: the bot's managed Discord role ID for role mentions.
DISCORD_BOT_ROLE_ID=
LOG_LEVEL=info

# Persist this directory across deployments; run one bot instance.
DATA_DIR=./data
RESETS_POLL_SECONDS=300
ACTIVITY_COLLECTOR_ENABLED=true
ACTIVITY_ANALYSIS_ENABLED=true
ACTIVITY_RETENTION_DAYS=90
# Comma-separated channel IDs; excluded thread parents are also respected.
ACTIVITY_EXCLUDED_CHANNEL_IDS=

# Destinations are configured in Discord with /resets and /activity-summary.

# Optional channel conversations via OpenClaw's native Codex runtime.
# Requires Message Content Intent in the Discord Developer Portal. See docs/OPENCLAW.md.
OPENCLAW_ENABLED=false
# Respond in every channel visible to @everyone, excluding private threads.
OPENCLAW_PUBLIC_CHANNELS=false
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_TOKEN=
OPENCLAW_AGENT_ID=discord
# Comma-separated channel IDs; an allowed parent includes its threads.
OPENCLAW_CHANNEL_IDS=
OPENCLAW_TIMEOUT_SECONDS=60

# Native OpenClaw Discord handling (requires the official Discord plugin and paired Gateway device).
OPENCLAW_NATIVE_DISCORD=false
OPENCLAW_GATEWAY_URL=ws://threesixty-openclaw:18789
# Enable only for the trusted private Docker network; use wss:// elsewhere.
OPENCLAW_PRIVATE_NETWORK=false

# OpenClaw companion service only: read-only Uptime Kuma metrics tool.
# Store values as Coolify secrets. The Cloudflare service token must grant only /metrics.
KUMA_METRICS_API_KEY=
KUMA_CF_ACCESS_CLIENT_ID=
KUMA_CF_ACCESS_CLIENT_SECRET=
