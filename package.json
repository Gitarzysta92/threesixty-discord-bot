{
  "name": "threesixty-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Modular Discord bot for internal company workflows",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "commands:deploy": "node --env-file-if-exists=.env --import tsx scripts/deploy-commands.ts",
    "commands:deploy:production": "node --env-file-if-exists=.env dist/deploy-commands.js"
  },
  "dependencies": {
    "@openclaw/gateway-client": "^2026.9.6",
    "discord.js": "^14.27.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
